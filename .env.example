APP_NAME="Executive AI Advisor"
APP_ENV=development
APP_DEBUG=true

POSTGRES_USER=executive_ai
POSTGRES_PASSWORD=change_me_in_local_development
POSTGRES_DB=executive_ai_advisor
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://executive_ai:change_me_in_local_development@db:5432/executive_ai_advisor
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=25
OPENAI_API_KEY=
LLM_PROVIDER=mock
OPENAI_CHAT_MODEL=gpt-6-luna
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
XAI_API_KEY=
XAI_CHAT_MODEL=grok-4.3
# Local OpenAI-compatible server (Ollama, llama.cpp server, vLLM). Used when LLM_PROVIDER=local.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=llama3.2:3b
LOCAL_LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
MAX_EMBEDDING_CHUNKS_PER_REQUEST=200
MAX_EMBEDDING_TEXT_CHARS=12000
MAX_SEARCH_QUERY_CHARS=2000

# MCP server. See docs/runbooks/mcp-operations.md.
# Comma-separated label:sha256 pairs. Generate with: python -m app.mcp_server.tokens <label>
MCP_AUTH_TOKENS=
MCP_ALLOW_INSECURE_BIND=false
MCP_MODEL_POLICY_FILE=config/models.yaml
MCP_RATE_LIMIT_READ_PER_MINUTE=60
MCP_RATE_LIMIT_LLM_PER_MINUTE=10
MCP_RATE_LIMIT_LLM_PER_DAY=200
MCP_AUDIT_STORE_TEXT=false
# HMAC-SHA256 key for free-text audit hashes, at least 32 characters. Required for HTTP on a
# non-loopback host. Generate: python -c "import secrets; print(secrets.token_hex(32))"
MCP_AUDIT_HASH_KEY=
# Fail-closed audit. Set to false to refuse every call that cannot be audited, with no override.
MCP_AUDIT_ALLOW_UNAUDITED_OVERRIDE=true
MCP_AUDIT_FALLBACK_FILE=data/audit/mcp_audit_fallback.jsonl
